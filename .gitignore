app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Secrets and credentials (never commit)
.env
.env.*
*.jks
*.keystore
key.properties
*.p12
*.mobileprovision
*service-account*.json
*-service-account.json

# Firebase *client* configuration is intentionally committed.
# These files ship inside the app and are not secrets: they identify the
# project and the app. They grant no privileged server access.
#   android/app/google-services.json   -> generated by FlutterFire CLI
#   ios/Runner/GoogleService-Info.plist -> generated by FlutterFire CLI
#   lib/firebase_options.dart           -> generated by FlutterFire CLI
# Service-account keys, private keys and release signing material stay
# excluded above and must never be added to this repository.
